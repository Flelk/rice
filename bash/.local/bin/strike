#!/usr/bin/env python3
"""Terminal intro: a snowstorm over a small block > in the bottom-left corner.

Snow sways down and piles up on the > and along the bottom row, wind gusts blow everything
sideways a couple of times, and hail cracks against the > (and knocks snow off it). At the
end the > frosts over icy blue, then warms back to gray while all the snow melts away. Then
the screen clears and the prompt starts at the bottom. Any key skips it. Run from .bashrc on new terminals.

(Earlier versions: the TerminalTextEffects thunderstorm is in git history; the old
hand-drawn rain is strike-classic.)
"""

import math
import os
import random
import select
import sys
import termios
import time
import tty

CHEVRON = [   # drawn 2 columns off the window edge, last row on the bottom row
    "█▄",
    " ▀█▄",
    " ▄█▀",
    "█▀",
]
LEFT = 2

# timeline, in seconds
FADE_IN = 0.25       # the > fades in (dimmed: it's stormy)
STORM = 3.0          # snow + hail keep coming until here
FROST = 0.45         # then the > frosts over...
WARM = 0.55          # ...and warms back to gray while the snow on it melts
FPS = 60

# snow drifts down slowly, sways, and piles up on the > and the bottom row; a third of it
# is "far away": dimmer, slower, and it falls behind the > instead of landing on anything
SNOW = ("*", "·", "+", ".")
SNOW_NEAR = ("F2F6FA", "D8E0E8")
SNOW_FAR = "6E7884"
SNOW_RATE = 0.7              # flakes per second, per column of the window
SNOW_SPEED = (0.22, 0.45)    # window heights per second
PILE = "▁▂▃▄▅"               # snow piling up on top of the >, one step per level (a cap, not a tower)
PILE_PER_FLAKE = 2           # levels each flake adds
# hail drops fast, bounces once on the floor, and shatters on the >
HAIL = ("o", "•", "°")
HAIL_COLOR = "A9C8E8"        # icy blue
HAIL_RATE = 0.12
HAIL_SPEED = (1.1, 1.6)
SPARKS = ("'", "`", ".", ",", "*")
# the > is only 4 columns wide, so on top of the rates above, this many per second fall
# right over it (otherwise ~2 flakes land on it per storm)
AIMED = {"snow": 7, "hail": 1.5}
# wind: a couple of gusts, each blows for about a second then dies down
GUSTS = 2
GUST_STRENGTH = (10, 18)     # columns per second, at its peak

GRAYS = ("555555", "D0D0D0")   # the > from bottom to top, the same grays as the bar
FROST_COLOR = "BFE6FF"
BACKGROUND = "0E0E0E"          # kitty's background, for fades


def rgb(hex_color):
    return tuple(int(hex_color[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, amount):
    amount = min(1.0, max(0.0, amount))
    return tuple(round(x + (y - x) * amount) for x, y in zip(a, b))


BG = rgb(BACKGROUND)


class Particle:
    def __init__(self, x, y, vx, vy, symbol, color, kind, life=None):
        self.x, self.y, self.vx, self.vy = x, y, vx, vy
        self.symbol, self.color, self.kind = symbol, color, kind
        self.life = self.age = life   # sparks only
        self.bounced = False
        self.sway = (random.uniform(0.6, 1.5), random.uniform(2, 4), random.uniform(0, 6.3))


class Storm:
    def __init__(self, cols, rows):
        self.cols, self.rows = cols, rows
        # the >: cell -> (symbol, final color); "▄" cells have an empty top half snow can fill
        self.chevron = {}
        top = rows - len(CHEVRON)
        for r, line in enumerate(CHEVRON):
            shade = mix(rgb(GRAYS[1]), rgb(GRAYS[0]), r / (len(CHEVRON) - 1))
            for c, symbol in enumerate(line):
                if symbol != " ":
                    self.chevron[(top + r, LEFT + c)] = (symbol, shade)
        self.capped = set()   # "▄" cells with snow in their top half
        self.pile = {}        # cell -> snow level, 1..len(PILE)
        self.flash = {}       # chevron cell -> time a hailstone hit it
        self.particles = []
        self.spawn = {"snow": 0.0, "hail": 0.0}
        self.gusts = []
        for n in range(GUSTS):
            start = STORM * (n + random.uniform(0.15, 0.6)) / GUSTS
            self.gusts.append((start, random.uniform(0.8, 1.1),
                               random.choice((-1, 1)) * random.uniform(*GUST_STRENGTH)))

    def prefill(self):
        """Start with snow already filling the sky (but none on the > yet)."""
        t = -3.0
        while t < 0:
            self.step(t, 1 / FPS)
            t += 1 / FPS
        self.pile.clear()
        self.capped.clear()
        self.flash.clear()
        self.particles = [p for p in self.particles if p.kind != "spark"]

    def wind(self, t):
        return sum(s * math.sin(math.pi * (t - start) / d) ** 2
                   for start, d, s in self.gusts if start <= t <= start + d)

    def solid(self, cell):
        return cell in self.chevron

    def add_snow(self, cell, levels):
        if cell[0] < 0:
            return
        self.pile[cell] = min(len(PILE), self.pile.get(cell, 0) + levels)

    def shatter(self, p, cell, t):
        """A hailstone hits the > (or the snow on it): sparks fly, and it knocks snow off."""
        if cell in self.chevron:
            self.flash[cell] = t
        hit_snow = self.pile.get(cell) or cell in self.capped
        if self.pile.get(cell):
            self.pile[cell] -= 3
            if self.pile[cell] <= 0:
                del self.pile[cell]
        self.capped.discard(cell)
        color = SNOW_NEAR[0] if hit_snow else "FFFFFF"
        for _ in range(random.randint(4, 7)):
            self.particles.append(Particle(
                p.x, cell[0] - 0.6, random.uniform(-12, 12), random.uniform(-14, -5),
                random.choice(SPARKS), color, "spark", life=random.uniform(0.2, 0.4)))

    def step(self, t, dt):
        if t < STORM:
            for kind, rate in (("snow", SNOW_RATE), ("hail", HAIL_RATE)):
                self.spawn[kind] += rate * self.cols * dt
                self.spawn["aimed " + kind] = self.spawn.get("aimed " + kind, 0) + AIMED[kind] * dt
            for kind in list(self.spawn):
                while self.spawn[kind] >= 1:
                    self.spawn[kind] -= 1
                    if kind.startswith("aimed"):
                        kind = kind.split()[1]
                        x = random.uniform(LEFT - 1, LEFT + 4.5)
                        far = False
                    else:
                        x = random.uniform(-15, self.cols + 15)   # off the sides too, for the wind
                        far = random.random() < 1 / 3
                    if kind == "hail":
                        self.particles.append(Particle(
                            x, -1, 0, random.uniform(*HAIL_SPEED) * self.rows,
                            random.choice(HAIL), HAIL_COLOR, "hail"))
                    else:
                        speed = random.uniform(*SNOW_SPEED) * self.rows * (0.7 if far else 1)
                        self.particles.append(Particle(
                            x, -1, 0, speed, random.choice(SNOW),
                            SNOW_FAR if far else random.choice(SNOW_NEAR), "far" if far else "snow"))

        wind = self.wind(t)
        alive = []
        for p in self.particles:
            if p.kind == "spark":
                p.age -= dt
                p.vy += 40 * dt
                p.x += p.vx * dt
                p.y += p.vy * dt
                if p.age > 0:
                    alive.append(p)
                continue
            if p.kind == "hail":
                vx = p.vx + wind * 0.25
                if p.bounced:
                    p.vy += 60 * dt
            else:
                amp, freq, phase = p.sway
                vx = wind * (0.6 if p.kind == "far" else 1) + amp * freq * math.cos(freq * t + phase)
            if self.move(p, vx * dt, p.vy * dt, t):
                alive.append(p)
        self.particles = alive

    def move(self, p, dx, dy, t):
        """Move in small steps so nothing skips a cell. False once the particle is gone."""
        steps = max(1, math.ceil(max(abs(dx), abs(dy)) / 0.5))
        for _ in range(steps):
            old = (round(p.y), round(p.x))
            p.x += dx / steps
            p.y += dy / steps
            cell = (round(p.y), round(p.x))
            if p.y >= self.rows - 0.5:   # the floor
                if p.kind == "hail" and not p.bounced:
                    p.bounced = True
                    p.y = self.rows - 0.6
                    p.vy = -p.vy * 0.25
                    p.vx = random.choice((-1, 1)) * random.uniform(3, 8)
                    return True
                floor = (self.rows - 1, round(p.x))
                if p.kind == "snow":   # piles up along the bottom row, spreading a little to each side
                    for cell, levels in ((floor, PILE_PER_FLAKE), ((floor[0], floor[1] - 1), 1),
                                         ((floor[0], floor[1] + 1), 1)):
                        if 0 <= cell[1] < self.cols and cell not in self.chevron:
                            self.add_snow(cell, levels)
                return False
            if cell == old or p.kind == "far":
                continue
            if p.kind == "hail":
                if self.solid(cell) or self.pile.get(cell):
                    self.shatter(p, cell, t)
                    return False
                continue
            # snow: fill the top half of a "▄" in the >, add to a pile, or land on top of something
            if cell in self.chevron and self.chevron[cell][0] == "▄" and cell not in self.capped:
                self.capped.add(cell)
                return False
            if self.pile.get(cell):
                self.add_snow(cell, PILE_PER_FLAKE)
                return False
            if self.solid(cell):
                if cell[0] > old[0]:   # came down onto it: settle right on top of it
                    above = (cell[0] - 1, cell[1])
                    if not self.solid(above):
                        self.add_snow(above, PILE_PER_FLAKE)
                    return False
                p.x -= dx / steps     # blown sideways into it: just stop going sideways
        return True

    def frame(self, t):
        """Every visible cell -> (symbol, fg, bg or None), for time t."""
        # how the > looks: dim during the storm, then frost, then its real grays
        def chevron_color(final):
            dim = mix(BG, final, 0.5)
            if t < FADE_IN:
                return mix(BG, dim, t / FADE_IN)
            if t < STORM:
                return dim
            if t < STORM + FROST:
                return mix(dim, rgb(FROST_COLOR), (t - STORM) / FROST)
            return mix(rgb(FROST_COLOR), final, (t - STORM - FROST) / WARM)

        melt = max(0.0, (t - STORM - FROST) / WARM)   # settled snow and everything falling fades out
        cells = {}

        def put(cell, symbol, fg, bg=None):
            if 0 <= cell[0] < self.rows and 0 <= cell[1] < self.cols:
                cells[cell] = (symbol, fg, bg)

        for layer in ("far", "chevron", "pile", "snow", "hail", "spark"):
            if layer == "chevron":
                for cell, (symbol, final) in self.chevron.items():
                    color = chevron_color(final)
                    if cell in self.flash:
                        color = mix(rgb("FFFFFF"), color, (t - self.flash[cell]) / 0.15)
                    if cell in self.capped:   # snow on top, the > underneath
                        put(cell, "▀", mix(rgb(SNOW_NEAR[0]), BG, melt), color)
                    else:
                        put(cell, symbol, color)
            elif layer == "pile":
                for cell, level in self.pile.items():
                    put(cell, PILE[level - 1], mix(rgb(SNOW_NEAR[0]), BG, melt))
            else:
                for p in self.particles:
                    if p.kind == layer:
                        color = rgb(p.color)
                        if p.kind == "spark":
                            color = mix(color, rgb(HAIL_COLOR), 1 - p.age / p.life * 2)
                            color = mix(color, BG, 1 - p.age / p.life)
                        put((round(p.y), round(p.x)), p.symbol, mix(color, BG, melt))
        return cells


def sgr(fg, bg):
    code = "\x1b[38;2;%d;%d;%dm" % fg
    return code + ("\x1b[48;2;%d;%d;%dm" % bg if bg else "\x1b[49m")


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return
    cols, rows = os.get_terminal_size()
    storm = Storm(cols, rows)
    storm.prefill()

    # any key skips: read keys without waiting for enter, without echoing them
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out = sys.stdout
    try:
        out.write("\x1b[?25l\x1b[0m\x1b[2J")
        start = last = time.monotonic()
        shown = {}
        while True:
            now = time.monotonic()
            t = now - start
            if t > STORM + FROST + WARM:
                break
            storm.step(t, now - last)
            last = now
            cells = storm.frame(t)
            # only redraw what changed since the last frame
            draw = []
            for cell in shown.keys() - cells.keys():
                draw.append("\x1b[%d;%dH\x1b[0m " % (cell[0] + 1, cell[1] + 1))
            for cell, look in cells.items():
                if shown.get(cell) != look:
                    symbol, fg, bg = look
                    draw.append("\x1b[%d;%dH%s%s" % (cell[0] + 1, cell[1] + 1, sgr(fg, bg), symbol))
            out.write("".join(draw))
            out.flush()
            shown = cells
            if select.select([fd], [], [], max(0.0, 1 / FPS - (time.monotonic() - now)))[0]:
                os.read(fd, 64)
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        # clear, and leave the cursor on the bottom row for the prompt
        out.write(f"\x1b[0m\x1b[2J\x1b[{rows}H\x1b[?25h")
        out.flush()


main()
