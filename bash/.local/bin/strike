#!/usr/bin/env python3
"""Terminal intro, omarchy style: TerminalTextEffects' thunderstorm over a big block >,
with one bolt aimed straight at it. Then the screen clears and the prompt starts at the
bottom. Any key skips it. Run from .bashrc on new terminals.

Needs python-terminaltexteffects (AUR); without it this quietly does nothing.
The old hand-drawn version is strike-classic.
"""

import os
import random
import select
import sys
import termios
import time
import tty

try:
    import terminaltexteffects as tte
    from terminaltexteffects.effects import effect_thunderstorm as storm
except ImportError:
    sys.exit(0)

CHEVRON = "\n".join("  " + line for line in [   # 2 columns off the window edge
    "██▄",
    " ▀██▄",
    "   ▀██▄",
    "   ▄██▀",
    " ▄██▀",
    "██▀",
])
TARGET_COLUMN = 6    # where the bolt lands: through the middle of the >
STRIKE_AFTER = 20    # frames into the storm before it strikes (60 fps)
STORM_SECONDS = 1    # storm keeps going at least this long, and until the strike is done
FADE_TICKS = 3       # per fade step; tte's 12 means ~1.4s of fading before and after the storm
OUTRO_FRAMES = 25    # frames after the storm (the > fading back in), then stop; tte would wait
                     # for every raindrop to land, ~10s, but the screen gets cleared anyway
FRAME_RATE = 100     # tte's 60 makes the whole thing ~4.5s; this runs every part faster

# colors: tte's blue bolt + orange glow, the > in the same grays as the bar
LIGHTNING = "68A3E8"
GLOW = "EF5411"
SPARKS = "FF4D00"
GRAYS = ("555555", "D0D0D0")
BACKGROUND = "0E0E0E"   # kitty's background, for fades


def speed_up(scene):
    """Make every frame of a scene FADE_TICKS long (the frame index map has to be rebuilt)."""
    frames = list(scene.frames)
    scene.frames.clear()
    scene.frame_index_map.clear()
    scene.easing_total_steps = 0
    for frame in frames:
        frame.duration = FADE_TICKS
        scene.frames.append(frame)
        for _ in range(FADE_TICKS):
            scene.frame_index_map[scene.easing_total_steps] = frame
            scene.easing_total_steps += 1


class AimedStorm(storm.ThunderstormIterator):
    """tte's thunderstorm, but with exactly one strike, at a set time, onto the >."""

    def __init__(self, effect):
        super().__init__(effect)
        self.storm_frames = 0
        self.outro_frames = 0
        self.struck = False
        for char in self.terminal.get_characters():
            for scene_id in ("fade", "unfade"):
                speed_up(char.animation.query_scene(scene_id))

    def setup_lightning_strike(self, branch_neighbor=None):
        if branch_neighbor is not None:   # side branches: tte's own random ones
            return super().setup_lightning_strike(branch_neighbor)
        # same as tte's main bolt, except it zigzags toward TARGET_COLUMN: it moves at most
        # one column per row, so every step keeps it close enough to still get there.
        # it starts up and to the right, so it comes in diagonally instead of along the edge
        canvas = self.terminal.canvas
        row = canvas.top
        reach = (row - canvas.bottom) // 2
        column = min(canvas.right, TARGET_COLUMN + random.randint(reach // 3, reach))
        while row >= canvas.bottom:
            if not self.available_strike_chars:
                self.build_strike_characters(20)
            below = row - canvas.bottom
            moves = [(s, d) for s, d in (("\\", 1), ("/", -1), ("|", 0))
                     if below == 0 or abs(column - TARGET_COLUMN + d) <= below - 1]
            symbol, step = random.choice(moves)
            char = self.get_next_strike_char()
            char.motion.set_coordinate(tte.Coord(column, row))
            char.animation.set_appearance(symbol=symbol, colors=tte.ColorPair(fg=self.config.lightning_color))
            self.pending_strike_chars.append(char)
            row -= 1
            column += step
            if random.random() < self.strike_branch_chance:
                self.strike_branch_chance -= 0.01
                self.setup_lightning_strike(branch_neighbor=char)
        self.strike_branch_chance = 0.05
        self.setup_sparks_for_impact()

    def __next__(self):
        # tte's loop, with the random strikes swapped for the one aimed strike
        if self.phase == "complete":
            self.outro_frames += 1
            if self.outro_frames > OUTRO_FRAMES:
                raise StopIteration
        if self.active_characters or self.phase != "complete":
            if self.phase == "pre-storm":
                self.pre_storm_text_fade()
                self.phase = "waiting"
            elif self.phase == "storm":
                self.rain()
                self.storm_frames += 1
                if not self.struck and self.storm_frames >= STRIKE_AFTER:
                    self.struck = self.strike_in_progress = True
                    self.lightning_strike()
                if self.strike_in_progress:
                    self.step_lightning_strike()
                for char in self.pending_glow_chars:
                    self.active_characters.add(char)
                self.pending_glow_chars.clear()
                if (self.struck and not self.strike_in_progress
                        and time.monotonic() - self.storm_start_time >= STORM_SECONDS):
                    self.post_storm_text_fade_in()
                    self.phase = "complete"
            self.update()
            return self.frame
        raise StopIteration


class Strike(storm.Thunderstorm):
    @property
    def _iterator_cls(self):
        return AimedStorm


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return
    effect = Strike(CHEVRON)
    config = effect.effect_config
    config.lightning_color = tte.Color(LIGHTNING)
    config.glowing_text_color = tte.Color(GLOW)
    config.spark_glow_color = tte.Color(SPARKS)
    config.final_gradient_stops = tuple(tte.Color(c) for c in GRAYS)
    term = effect.terminal_config
    term.canvas_width = term.canvas_height = 0   # whole window
    term.anchor_text = "sw"                       # > in the bottom-left corner
    term.terminal_background_color = tte.Color(BACKGROUND)
    term.frame_rate = FRAME_RATE

    # any key skips: read keys without waiting for enter, without echoing them
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        with effect.terminal_output() as out:
            for frame in effect:
                out.print(frame)
                if select.select([fd], [], [], 0)[0]:
                    os.read(fd, 64)
                    break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        # clear, and leave the cursor on the bottom row for the prompt
        sys.stdout.write(f"\x1b[0m\x1b[2J\x1b[{os.get_terminal_size().lines}H\x1b[?25h")
        sys.stdout.flush()


main()
