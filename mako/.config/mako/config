# mako: colors come from ~/.local/bin/theme (SUPER + T)

font=JetBrainsMono Nerd Font 11

# same 1px border, 4px corners and 10px gap as hyprland windows / the bar
border-size=1
border-radius=4
padding=12,14
margin=6
outer-margin=10
width=340
height=120
max-visible=4
anchor=top-right
layer=overlay
icons=0
markup=1
format=<b>%s</b>\n%b
default-timeout=5000

# colors + urgency sections (keep last)
include=~/.cache/theme/mako
