(defwindow bar [monitor]
	:monitor monitor
	:geometry (geometry :x "0%" :y "0%"
						:width "100%" :height "40px"
						:anchor "top center")
	:stacking "fg"
	:exclusive true
	(bar :monitor monitor))

;; bar icon: ethernet > wifi > nothing
(defpoll net_icon :interval "5s"
	"nmcli -t -f TYPE,STATE dev | awk -F: '$2 == \"connected\" {c[$1] = 1} END {print c[\"ethernet\"] ? \"󰈀\" : c[\"wifi\"] ? \"󰤨\" : \"󰤭\"}'")

(defpoll clock :interval "1s" "date '+%a %d · %H:%M:%S'")

;; laptop battery (hidden on the desktop: battery.sh skips mouse/keyboard batteries)
(defpoll battery :interval "10s" :initial "{\"on\":false,\"pct\":0,\"state\":\"\",\"icon\":\"\",\"low\":false}"
	"~/.config/eww/scripts/battery.sh")

;; floats like a window: 10px gap, 1px border, 4px corners (see .bar)
(defwidget bar [monitor]
	(centerbox :class "bar-box" :orientation "h"
		(box :halign "start" :valign "center" :space-evenly false
			;; arch logo: opens the start panel
			(button :class "arch" :onclick "~/.config/eww/scripts/start.sh toggle ${monitor}" "")
			(box :class "vsep" :valign "center")
			(workspaces))
		(label :class "clock" :valign "center" :text clock)
		(box :halign "end" :valign "center" :space-evenly false :spacing 4
			;; notes (obsidian): notebooks list + pages drawer
			(button :class "power" :tooltip "notes" :onclick "~/.config/eww/scripts/notes.sh toggle ${monitor}" "󰠮")
			;; screenshot: click = select a region, right click = whole monitor (also SUPER SHIFT S)
			(button :class "power" :tooltip "screenshot (right click: whole screen)"
				:onclick "~/.config/eww/scripts/screenshot.sh"
				:onrightclick "~/.config/eww/scripts/screenshot.sh screen"
				"󰹑")
			(button :class "power" :onclick "~/.config/eww/scripts/net.sh toggle ${monitor}" net_icon)
			;; battery: click opens the power panel (where the power modes are)
			(button :class "power battery ${battery.low ? 'low' : ''}" :visible {battery.on}
				:tooltip {battery.state == "charging" ? "charging" : battery.state == "plugged" ? "plugged in" : "on battery"}
				:onclick "~/.config/eww/scripts/panel.sh toggle ${monitor}"
				(box :space-evenly false :spacing 4
					(label :text {battery.icon})
					(label :text "${battery.pct}%")))
			(button :class "power" :onclick "~/.config/eww/scripts/panel.sh toggle ${monitor}" ""))))

;; WORKSPACES: the script decides which buttons show and how they look
(deflisten workspaces :initial "[]" "~/.config/eww/scripts/workspaces.sh")
(defwidget workspaces []
	(box :class "workspaces" :spacing 2
		(for w in workspaces
			(button :class {w.class}
				:onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${w.n} })'"
				(label :text {w.label})))))

;; POWER PANEL: hyprland slides the window in from the right (layer rule on "eww-panel"),
;; then its sections follow one by one (panel.sh steps panel_stage 1..4).
;; closes when the mouse leaves the hover zone
(defvar panel_open false)
(defvar panel_stage 0)
(deflisten volume :initial "0" "~/.config/eww/scripts/volume.sh")
(defpoll brightness :interval "30s" "~/.config/eww/scripts/brightness.sh get")
(defpoll vram :interval "2s"   ;; "" without an nvidia card: the vram tile hides itself
	"command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '$2 > 0 {printf \"%d\", $1 * 100 / $2}'")
;; performance | balanced | power-saver, or "none" when power-profiles-daemon isn't installed
(defpoll power_profile :interval "10s" :initial "none" "~/.config/eww/scripts/profile.sh get")
(defpoll uptime :interval "60s" "uptime -p | sed -E 's/^up //; s/ weeks?,?/w/; s/ days?,?/d/; s/ hours?,?/h/; s/ minutes?/m/'")

(defwindow panel
	:monitor 0
	:geometry (geometry :x "0px" :y "0px" :anchor "top right")
	:stacking "overlay"
	:exclusive false
	:namespace "eww-panel"
	;; panel-zone: invisible margin (~25% of the panel) that still counts as "on it"
	(eventbox :onhoverlost "~/.config/eww/scripts/panel.sh close"
		(box :class "panel-zone" (panel))))

;; one section of the panel; slides in from the right + fades in once panel_stage reaches n
(defwidget stage [n]
	(revealer :halign "end" :transition "slideleft" :duration "350ms" :reveal {panel_stage >= n}
		(revealer :transition "crossfade" :duration "350ms" :reveal {panel_stage >= n}
			(box :class "stage" (children)))))

(defwidget panel []
	(box :class "panel-box" :orientation "v" :space-evenly false :spacing 14
		;; profile
		(stage :n 1 (box :space-evenly false :spacing 12
			(box :class "pfp" :valign "center")
			(box :orientation "v" :valign "center" :space-evenly false
				(label :class "user" :halign "start" :text "flelk")
				(label :class "dim" :halign "start" :text "up ${uptime}"))))
		;; power actions
		(stage :n 2 (box :class "actions" :spacing 4
			(action :icon "⏻" :tip "Shut down" :cmd "poweroff")
			(action :icon "󰜉" :tip "Reboot"    :cmd "reboot")
			(action :icon "󰌾" :tip "Lock"      :cmd "lock")
			(action :icon "󰒲" :tip "Sleep"     :cmd "suspend")
			(action :icon "󰍃" :tip "Log out"   :cmd "logout")))
		(box :class "sep")
		;; stats
		(stage :n 3 (box :orientation "v" :space-evenly false :spacing 6
			;; power modes
			(box :class "modes" :visible {power_profile != "none"} :spacing 4
				(mode :name "power-saver" :icon "󰌪" :text "saver")
				(mode :name "balanced"    :icon "󰾅" :text "balanced")
				(mode :name "performance" :icon "󰓅" :text "boost"))
			(stat :icon "󰻠" :name "cpu"  :value {round(EWW_CPU.avg, 0)})
			(stat :icon "󰍛" :name "ram"  :value {round(EWW_RAM.used_mem_perc, 0)})
			(box :visible {vram != ""}
				(stat :icon "󰢮" :name "vram" :value {vram == "" ? 0 : vram}))))
		;; sliders
		(stage :n 4 (box :orientation "v" :space-evenly false :spacing 14
		(box :orientation "v" :space-evenly false :spacing 6
			(box (label :class "dim" :halign "start" :text "vol")
				(label :class "dim" :halign "end" :text "${volume}%"))
			(scale :class "vol" :min 0 :max 101 :value volume :round-digits 0
				:onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"))
		(box :orientation "v" :space-evenly false :spacing 6
			(box (label :class "dim" :halign "start" :text "brightness")
				(label :class "dim" :halign "end" :text "${brightness}%"))
			(scale :class "vol" :min 0 :max 101 :value brightness :round-digits 0
				:onchange "~/.config/eww/scripts/brightness.sh set {}"))))))

(defwidget action [icon tip cmd]
	(button :class "action" :tooltip tip
		:onclick "~/.config/eww/scripts/panel.sh ${cmd}"
		(label :text icon)))

(defwidget mode [name icon text]
	(button :class "tab mode ${power_profile == name ? 'active' : ''}"
		:onclick "~/.config/eww/scripts/profile.sh set ${name}"
		(box :orientation "v" :space-evenly false :spacing 2
			(label :class "mode-icon" :text icon)
			(label :text text))))

(defwidget stat [icon name value]
	(box :class "stat" :space-evenly false :spacing 12
		(circular-progress :class "ring" :value value :thickness 3 :start-at 75 :clockwise true
			(label :class "ring-icon" :text icon))
		(label :class "stat-name" :valign "center" :text name)
		(label :class "stat-value" :hexpand true :halign "end" :valign "center" :text "${value}%")))

;; START PANEL (arch button): mirror of the power panel, hyprland slides it in from the left
;; (layer rule on "eww-start"), then its sections follow one by one (start.sh steps start_stage 1..5).
;; the rice drawer pops out to its right. closes when the mouse leaves the hover zone
(defvar start_open false)
(defvar start_stage 0)
(defvar start_rice false)
(defvar start_query "")
(defvar start_results "[]")   ;; search hits, filled by start.sh search
(defvar start_pinned "[]")    ;; rows of 4, "+" tile last (apps.sh pinned)
(deflisten media :initial "{\"on\":false,\"playing\":false,\"title\":\"\",\"artist\":\"\",\"art\":\"\"}"
	"~/.config/eww/scripts/media.sh")
(defpoll kernel :interval "1h" "uname -r")
(defpoll pkgs :interval "10m" "pacman -Qq | wc -l")
(defpoll start_updates :interval "30m" :initial "0" "(checkupdates; yay -Qua) 2>/dev/null | wc -l")

(defwindow start
	:monitor 0
	:geometry (geometry :x "0px" :y "0px" :anchor "top left")
	:stacking "overlay"
	:exclusive false
	:focusable true
	:namespace "eww-start"
	(eventbox :onhoverlost "~/.config/eww/scripts/start.sh close"
		(box :class "start-zone" :space-evenly false
			(start)
			(revealer :valign "start" :transition "slideright" :duration "250ms" :reveal start_rice
				(rice)))))

;; like stage, but slides in from the left
(defwidget lstage [n]
	(revealer :halign "start" :transition "slideright" :duration "350ms" :reveal {start_stage >= n}
		(revealer :transition "crossfade" :duration "350ms" :reveal {start_stage >= n}
			(box :class "stage" (children)))))

(defwidget start []
	(box :class "panel-box" :orientation "v" :space-evenly false :spacing 14
		;; system
		(lstage :n 1 (box :space-evenly false :spacing 12
			(box :class "pfp" :valign "center")
			(box :orientation "v" :valign "center" :space-evenly false
				(label :class "user" :halign "start" :text "arch linux")
				(label :class "dim" :halign "start" :text "${kernel} · ${pkgs} pkgs"))))
		;; search: typing swaps the pinned grid for results, enter opens the top one
		(lstage :n 2 (box :class "search" :space-evenly false :spacing 10
			(label :class "dim" :text "")
			(input :hexpand true
				:onchange "~/.config/eww/scripts/start.sh search '{}'"
				:onaccept "~/.config/eww/scripts/start.sh first")))
		;; pinned apps (right click unpins, + pins one) / search results
		(lstage :n 3 (box :orientation "v" :space-evenly false :spacing 4
			(label :class "section" :halign "start" :text {start_query == "" ? "pinned" : "results"})
			(box :orientation "v" :space-evenly false :spacing 4 :visible {start_query == ""}
				(for row in start_pinned
					(box :space-evenly false :spacing 4
						(for a in row (app-tile :app a)))))
			(box :orientation "v" :space-evenly false :spacing 2 :visible {start_query != ""}
				(for a in start_results
					(button :class "net-row" :onclick "~/.config/eww/scripts/start.sh launch ${a.id}"
						(box :space-evenly false :spacing 10
							(image :path {a.icon} :image-width 20 :image-height 20)
							(label :halign "start" :hexpand true :limit-width 26 :text {a.name}))))
				(label :class "net-empty dim" :halign "start" :visible {arraylength(start_results) == 0}
					:text "no apps match"))))
		(box :class "sep")
		;; now playing (playerctl)
		(lstage :n 4 (box :class "media" :space-evenly false :spacing 12
			(box :class "art" :valign "center"
				:style {media.art == "" ? "" : "background-image: url('${media.art}');"}
				(label :visible {media.art == ""} :text ""))
			(box :orientation "v" :valign "center" :hexpand true :space-evenly false :spacing 2
				(label :halign "start" :limit-width 22 :text {media.on ? media.title : "nothing playing"})
				(label :class "dim" :halign "start" :limit-width 22 :text {media.artist})
				(box :class "media-controls" :halign "start" :space-evenly false :spacing 16
					(button :onclick "playerctl previous" "")
					(button :onclick "playerctl play-pause" {media.playing ? "" : ""})
					(button :onclick "playerctl next" "")))))
		;; updates, disk, rice drawer
		(lstage :n 5 (box :spacing 4
			(sys-tile :icon "" :cmd "update"
				:text {start_updates == "0" ? "up to date" : "${start_updates} updates"})
			(sys-tile :icon "" :text {round(EWW_DISK["/"].used_perc, 0) + "% disk"})
			(sys-tile :icon "" :text "rice" :cmd "rice" :on start_rice)))))

;; pinned app, or the "+" tile at the end
(defwidget app-tile [app]
	(button :class "tile ${app.id == '+' ? 'add' : ''}"
		:tooltip {app.id == "+" ? "pin an app" : "${app.name} (right click: unpin)"}
		:onclick {app.id == "+" ? "~/.config/eww/scripts/start.sh pin" : "~/.config/eww/scripts/start.sh launch ${app.id}"}
		:onrightclick {app.id == "+" ? "" : "~/.config/eww/scripts/start.sh unpin ${app.id}"}
		(box :orientation "v" :space-evenly false :spacing 6 :valign "center"
			(label :class "tile-plus" :visible {app.id == "+"} :text "+")
			(image :visible {app.id != "+"} :path {app.icon == "" ? "/usr/share/icons/Adwaita/scalable/mimetypes/application-x-executable.svg" : app.icon}
				:image-width 30 :image-height 30)
			(label :class "tile-name" :limit-width 8 :text {app.name}))))

;; no cmd = just shows info
(defwidget sys-tile [icon text ?cmd ?on]
	(button :class "action sys-tile ${on == true ? 'on' : ''} ${cmd == '' ? 'info' : ''}"
		:onclick {cmd == "" ? "" : "~/.config/eww/scripts/start.sh ${cmd}"}
		(box :orientation "v" :space-evenly false :spacing 4
			(label :text icon)
			(label :class "sys-text" :text text))))

;; RICE DRAWER: reloads + config shortcuts (opened in code)
(defwidget rice []
	(box :class "panel-box rice-box" :orientation "v" :space-evenly false :spacing 10
		(label :class "user" :halign "start" :text "rice")
		(box :class "sep")
		(label :class "section" :halign "start" :text "reload")
		(box :spacing 4
			(sys-tile :icon "" :text "bar"      :cmd "reload eww")
			(sys-tile :icon "" :text "hyprland" :cmd "reload hypr")
			(sys-tile :icon "" :text "mako"     :cmd "reload mako"))
		(label :class "section" :halign "start" :text "edit")
		(box :orientation "v" :space-evenly false :spacing 2
			(rice-row :icon "" :text "hyprland"      :cmd "edit hypr")
			(rice-row :icon "" :text "bar & panels"  :cmd "edit eww")
			(rice-row :icon "" :text "kitty"         :cmd "edit kitty")
			(rice-row :icon "" :text "launcher"      :cmd "edit fuzzel")
			(rice-row :icon "" :text "notifications" :cmd "edit mako")
			(rice-row :icon "" :text "fetch"         :cmd "edit fastfetch")
			(rice-row :icon "" :text "all dotfiles"  :cmd "edit dotfiles"))))

(defwidget rice-row [icon text cmd]
	(button :class "net-row" :onclick "~/.config/eww/scripts/start.sh ${cmd}"
		(box :space-evenly false :spacing 10
			(label :class "net-row-icon" :text icon)
			(label :halign "start" :hexpand true :text text))))

;; NETWORK PANEL: same slide-in + hover-to-close as the power panel (shares its "eww-panel" namespace).
;; both tabs: known (saved wifi / paired bluetooth) first, then unknown ones nearby.
;; wifi.sh / bt.sh only run while it's open. net.sh does the clicking.
(defvar net_open false)
(defvar net_tab "wifi")
(defvar net_busy "")   ;; id of the row that's connecting/pairing right now
(defvar net_msg "")    ;; error line under the list
(defpoll wifi :interval "3s" :run-while net_open
	:initial "{\"on\":false,\"known\":[],\"unknown\":[]}"
	"~/.config/eww/scripts/wifi.sh")
(defpoll bt :interval "2s" :run-while net_open
	:initial "{\"on\":false,\"scanning\":false,\"known\":[],\"unknown\":[]}"
	"~/.config/eww/scripts/bt.sh")

(defwindow net
	:monitor 0
	:geometry (geometry :x "0px" :y "0px" :anchor "top right")
	:stacking "overlay"
	:exclusive false
	:namespace "eww-panel"
	(eventbox :onhoverlost "~/.config/eww/scripts/net.sh close"
		(box :class "panel-zone" (net))))

(defwidget net []
	(box :class "panel-box net-box" :orientation "v" :space-evenly false :spacing 14
		(box :spacing 4
			(net-tab :name "wifi" :icon "󰤨" :text "wifi")
			(net-tab :name "bt"   :icon "󰂯" :text "bluetooth"))
		(box :class "sep")
		(stack :selected {net_tab == "wifi" ? 0 : 1} :transition "slideleftright" :duration "250ms"
			(wifi-tab)
			(bt-tab))
		(revealer :reveal {net_msg != ""} :transition "slidedown" :duration "200ms"
			(label :class "dim" :halign "start" :text net_msg))))

(defwidget net-tab [name icon text]
	(button :class "tab ${net_tab == name ? 'active' : ''}"
		:onclick "~/.config/eww/scripts/net.sh tab ${name}"
		(box :space-evenly false :spacing 8 :halign "center"
			(label :text icon)
			(label :text text))))

;; "title ......... [switch]" line at the top of each tab
(defwidget net-head [title on cmd]
	(box :space-evenly false :spacing 10
		(label :class "dim" :halign "start" :hexpand true :text title)
		(children)
		(button :class "switch ${on ? 'on' : ''}"
			:onclick "~/.config/eww/scripts/net.sh ${cmd}"
			(label :text {on ? "󰔡" : "󰨙"}))))

(defwidget net-row [icon name status busy onclick ?onrightclick]
	(button :class "net-row ${busy ? 'busy' : ''}" :onclick onclick :onrightclick onrightclick
		(box :space-evenly false :spacing 10
			(label :class "net-row-icon" :text icon)
			(label :halign "start" :hexpand true :limit-width 24 :text name)
			(label :class "dim" :text {busy ? "…" : status}))))

(defwidget wifi-tab []
	(box :orientation "v" :space-evenly false :spacing 10
		(net-head :title "wifi" :on {wifi.on} :cmd "wifi-power")
		(scroll :class "net-list" :vscroll true :hscroll false :height 280
			(box :orientation "v" :space-evenly false :spacing 2 :valign "start"
				(label :class "dim" :visible {!wifi.on} :halign "start" :text "wifi is off")
				(box :orientation "v" :space-evenly false :spacing 2 :visible {wifi.on}
					(label :class "section" :halign "start" :text "known")
					(box :orientation "v" :space-evenly false :spacing 2
						(for n in {wifi.known}
							(net-row :icon {n.icon} :name {n.ssid} :busy {net_busy == n.id}
								:status {n.active ? "connected" : ""}
								:onclick "~/.config/eww/scripts/net.sh wifi ${n.action} ${n.id}"
								:onrightclick "~/.config/eww/scripts/net.sh wifi forget ${n.id}")))
					(label :class "net-empty dim" :halign "start" :visible {arraylength(wifi.known) == 0}
						:text "no saved networks in range")
					(label :class "section" :halign "start" :text "unknown")
					(box :orientation "v" :space-evenly false :spacing 2
						(for n in {wifi.unknown}
							(net-row :icon {n.icon} :name {n.ssid} :busy {net_busy == n.id}
								:status {n.secure ? "󰌾" : ""}
								:onclick "~/.config/eww/scripts/net.sh wifi ${n.action} ${n.id}")))
					(label :class "net-empty dim" :halign "start" :visible {arraylength(wifi.unknown) == 0}
						:text "looking for networks…"))))))

(defwidget bt-tab []
	(box :orientation "v" :space-evenly false :spacing 10
		(net-head :title "bluetooth" :on {bt.on} :cmd "bt-power"
			(button :class "scan" :visible {bt.on} :active {!bt.scanning}
				:onclick "~/.config/eww/scripts/net.sh bt-scan"
				{bt.scanning ? "scanning…" : "scan"}))
		(scroll :class "net-list" :vscroll true :hscroll false :height 280
			(box :orientation "v" :space-evenly false :spacing 2 :valign "start"
				(label :class "dim" :visible {!bt.on} :halign "start" :text "bluetooth is off")
				(box :orientation "v" :space-evenly false :spacing 2 :visible {bt.on}
					(label :class "section" :halign "start" :text "known")
					(box :orientation "v" :space-evenly false :spacing 2
						(for d in {bt.known}
							(net-row :icon {d.icon} :name {d.name} :busy {net_busy == d.mac}
								:status {d.dongle ? (d.default ? "usb dongle · output" : "usb dongle")
								         : d.connected ? "connected" : ""}
								;; dongle: make it the audio output. bluetooth: (dis)connect, right click forgets
								:onclick {d.dongle ? "~/.config/eww/scripts/net.sh audio ${d.sink}"
								          : "~/.config/eww/scripts/net.sh bt ${d.connected ? 'disconnect' : 'connect'} ${d.mac}"}
								:onrightclick {d.dongle ? "" : "~/.config/eww/scripts/net.sh bt forget ${d.mac}"})))
					(label :class "net-empty dim" :halign "start" :visible {arraylength(bt.known) == 0}
						:text "nothing paired yet")
					(label :class "section" :halign "start" :text "unknown")
					(box :orientation "v" :space-evenly false :spacing 2
						(for d in {bt.unknown}
							(net-row :icon {d.icon} :name {d.name} :busy {net_busy == d.mac}
								:status "pair"
								:onclick "~/.config/eww/scripts/net.sh bt pair ${d.mac}")))
					(label :class "net-empty dim" :halign "start" :visible {arraylength(bt.unknown) == 0}
						:text {bt.scanning ? "looking…" : "nothing nearby"}))))))

;; NOTES PANEL (obsidian): every folder in ~/Notes is a notebook. clicking one slides its pages out
;; to the left, "open" jumps to its last edited page, right click deletes (asks first, goes to the trash). same slide-in + hover-to-close as the power
;; panel (shares its "eww-panel" namespace). notes.sh does the clicking.
(defvar notes_open false)
(defvar notes_books "[]")   ;; [{id, name, pages, age}]
(defvar notes_sel -1)       ;; id of the notebook in the drawer, -1 = drawer closed
(defvar notes_book "")      ;; its name
(defvar notes_pages "[]")   ;; its sections: [{name, pages: [{id, name, age}]}]
(defvar notes_drawer_h 0)

(defwindow notes
	:monitor 0
	:geometry (geometry :x "0px" :y "0px" :anchor "top right")
	:stacking "overlay"
	:exclusive false
	:namespace "eww-panel"
	(eventbox :onhoverlost "~/.config/eww/scripts/notes.sh close"
		(box :class "panel-zone" :space-evenly false
			(revealer :valign "start" :transition "slideleft" :duration "250ms" :reveal {notes_sel >= 0}
				(notes-drawer))
			(notes))))

(defwidget notes []
	(box :class "panel-box notes-box" :orientation "v" :space-evenly false :spacing 10
		(notes-head :title "notes" :tip "new notebook" :cmd "new-book")
		(box :class "sep")
		(label :class "dim net-empty" :halign "start" :visible {notes_books == "[]"}
			:text "no notebooks yet, + makes one")
		(box :orientation "v" :space-evenly false :spacing 2
			(for b in notes_books
				(box :space-evenly false :spacing 4
					(button :class "net-row ${notes_sel == b.id ? 'active' : ''}" :hexpand true
						:onclick "~/.config/eww/scripts/notes.sh book ${b.id}"
						:onrightclick "~/.config/eww/scripts/notes.sh del-book ${b.id}"
						(box :space-evenly false :spacing 10
							(label :class "net-row-icon" :text "󰠮")
							(box :orientation "v" :space-evenly false
								(label :halign "start" :limit-width 20 :text {b.name})
								(label :class "dim notes-meta" :halign "start"
									:text "${b.pages} ${b.pages == 1 ? 'page' : 'pages'} · ${b.age}"))))
					(button :class "notes-open" :valign "center"
						:onclick "~/.config/eww/scripts/notes.sh open ${b.id}" "open"))))))

;; pages of the selected notebook, grouped by section (loose pages first)
(defwidget notes-drawer []
	(box :class "panel-box notes-drawer" :orientation "v" :space-evenly false :spacing 10
		(notes-head :title notes_book :tip "new page" :cmd "new-page")
		(box :class "sep")
		(label :class "dim net-empty" :halign "start" :visible {notes_pages == "[]"}
			:text "no pages yet, + makes one")
		(scroll :vscroll true :hscroll false :height notes_drawer_h   ;; 0 when empty (hiding it with :visible
			;; breaks it: rows added while hidden never show)
			(box :orientation "v" :space-evenly false :spacing 2
				(for s in notes_pages
					(box :orientation "v" :space-evenly false :spacing 2
						(label :class "section" :halign "start" :visible {s.name != ""} :text {s.name})
						(for p in {s.pages}
							(button :class "net-row" :onclick "~/.config/eww/scripts/notes.sh page ${p.id}"
								:onrightclick "~/.config/eww/scripts/notes.sh del-page ${p.id}"
								(box :space-evenly false :spacing 10
									(label :class "net-row-icon" :text {p.canvas ? "󰕠" : "󰈙"})
									(label :halign "start" :hexpand true :limit-width 22 :text {p.name})
									(label :class "dim notes-meta" :text {p.age}))))))))))

;; "title ............ +" line at the top of both
(defwidget notes-head [title tip cmd]
	(box :space-evenly false
		(label :class "user" :halign "start" :hexpand true :limit-width 20 :text title)
		(button :class "notes-add" :tooltip tip :onclick "~/.config/eww/scripts/notes.sh ${cmd}" "󰐕")))
