(defwindow bar
	:monitor 0
		:geometry (geometry :x "0%" :y "0%"
							:width "100%" :height "30px"
							:anchor "top center")
		:stacking "fg"
		:exclusive true
		(bar))	
		
; first widget
(defwidget greeting []
	(label :text "hello babygirl"))

(defpoll time :interval "1s" "date '+%H:%M'")
(defpoll date :interval "60s" "date '+%a %b %d'")

(defwidget bar []
	(centerbox :orientation "h"
	(label :text "FlelkOS") 
	(label :text time)
	(label :text date)))
	
