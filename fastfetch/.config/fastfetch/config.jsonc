// fastfetch: only the basics. full module list: fastfetch --list-modules
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // devil.png is animated, but fastfetch only shows its first frame: run `fetch` to see it move.
    // other images in here: coffee-cat.png (width 30, height 12), toro.txt ("type": "file",
    //   "color": { "1": "white", "2": "red", "3": "bright_white" })
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/devil.png",
        "width": 22,    // in terminal cells; 22x10 is about square
        "height": 10,
        "padding": { "right": 3 }
    },
    "modules": [
        "break",   // two blank lines: centers the info next to the logo
        "break",
        "os",
        "kernel",
        "packages",
        "cpu",
        "gpu",
        "memory"
    ]
}
